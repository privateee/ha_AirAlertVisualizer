#!/usr/bin/with-contenv bashio

export DRONEVIS_HOST="0.0.0.0"
export DRONEVIS_PORT="8099"                       # HA ingress default port
export DRONEVIS_DB_PATH="/data/dronevis.db"       # persistent add-on store

export DRONEVIS_CHANNELS="$(bashio::config 'channels' | paste -sd, -)"
export DRONEVIS_POLL_INTERVAL="$(bashio::config 'poll_interval_seconds')"
export DRONEVIS_BACKFILL_PAGES="$(bashio::config 'backfill_pages')"
export DRONEVIS_AREA_LABEL="$(bashio::config 'area_label')"
export DRONEVIS_AREA_CENTER="$(bashio::config 'area_center_lat'),$(bashio::config 'area_center_lon')"
export DRONEVIS_AREA_RADIUS_KM="$(bashio::config 'area_radius_km')"
export DRONEVIS_MAP_THEME="$(bashio::config 'map_theme')"
export DRONEVIS_TILE_URL="$(bashio::config 'tile_url')"
export DRONEVIS_TILE_URL_DARK="$(bashio::config 'tile_url_dark' '')"
[ "${DRONEVIS_TILE_URL_DARK}" = "null" ] && export DRONEVIS_TILE_URL_DARK=""
export DRONEVIS_LOG_LEVEL="$(bashio::config 'log_level')"
export DRONEVIS_LOG_FORMAT="$(bashio::config 'log_format')"
export DRONEVIS_RETAIN_DAYS="$(bashio::config 'retain_days')"

export DRONEVIS_ALARM_THREATS="$(bashio::config 'alarm_threats' | paste -sd, -)"
export DRONEVIS_ALARM_MIN_CONFIDENCE="$(bashio::config 'alarm_min_confidence')"
export DRONEVIS_MQTT="$(bashio::config 'mqtt')"

# hand the Supervisor's MQTT broker (Mosquitto add-on) to the app
if bashio::services.available "mqtt"; then
  export DRONEVIS_MQTT_HOST="$(bashio::services 'mqtt' 'host')"
  export DRONEVIS_MQTT_PORT="$(bashio::services 'mqtt' 'port')"
  export DRONEVIS_MQTT_USERNAME="$(bashio::services 'mqtt' 'username')"
  export DRONEVIS_MQTT_PASSWORD="$(bashio::services 'mqtt' 'password')"
  bashio::log.info "MQTT broker: ${DRONEVIS_MQTT_HOST}:${DRONEVIS_MQTT_PORT}"
fi

mkdir -p /data
bashio::log.info "DroneVisualizer -> :${DRONEVIS_PORT} (ingress); channels: ${DRONEVIS_CHANNELS}"

exec python -m dronevis run
